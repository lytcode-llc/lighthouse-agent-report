{
  "name": "@lytcode/lighthouse-agent-report",
  "version": "2.0.0",
  "description": "Runs Lighthouse across your site and generates an agent-readable markdown report",
  "type": "module",
  "bin": {
    "lighthouse-agent-report": "dist/cli.js"
  },
  "main": "./dist/run.js",
  "types": "./dist/types.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@unlighthouse/cli": "^0.18.0"
  },
  "devDependencies": {
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "MIT",
  "author": "Lytcode LLC",
  "keywords": [
    "lighthouse",
    "core-web-vitals",
    "performance",
    "seo",
    "accessibility",
    "unlighthouse",
    "pagespeed",
    "cwv",
    "ai-agent",
    "next.js",
    "sveltekit",
    "astro",
    "gatsby"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lytcode-llc/lighthouse-agent-report.git"
  },
  "homepage": "https://github.com/lytcode-llc/lighthouse-agent-report#readme",
  "bugs": {
    "url": "https://github.com/lytcode-llc/lighthouse-agent-report/issues"
  }
}
